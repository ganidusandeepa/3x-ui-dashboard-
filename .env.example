# ============================================================
# 3x-ui Premium Dashboard Environment Configuration
# ============================================================

# Full URL to your local or remote 3x-ui panel
# IMPORTANT: If your panel uses a custom Web Base Path (e.g. /subpath/), include it!
PANEL_URL=http://127.0.0.1:2053

# Panel Authentication (Option 1: Admin Username and Password)
PANEL_USERNAME=admin
PANEL_PASSWORD=your_password_here

# Panel Authentication (Option 2: Bearer API Token - Recommended)
# Generated in: 3x-ui Sidebar -> Panel Settings -> Security -> API Token
# When set, this takes precedence over username/password and avoids session cookie expiration.
PANEL_API_TOKEN=

# Port for this dashboard web server (Default: 8080)
PORT=8080

# (Optional) Realtime metrics polling interval in milliseconds (Default: 1500)
# METRICS_INTERVAL_MS=1500

# (Optional) Multi-node panels JSON array
# PANEL_NODES=[{"name":"Node1","url":"https://node1.example.com:2053/base","apiToken":"..."}]
