# ========================================================
# 3x-ui Dashboard - Environment Configuration Template
# Copy this file to .env on your VPS and fill in your values.
# DO NOT commit .env with real credentials to GitHub!
# ========================================================

# 1. 3x-ui Panel Connection (Required)
# Full URL to your panel including protocol, port, and Web Base Path (if configured)
# Example: https://your-domain.com:2083/your_web_base_path
PANEL_URL=https://your-domain.com:2083/your_web_base_path

# 2. Panel Authentication
# Recommended: Scoped API Token from Panel Settings -> Security -> API Token
PANEL_API_TOKEN=your_3xui_api_token_here

# Fallback basic authentication (used if API Token is not set)
PANEL_USERNAME=admin
PANEL_PASSWORD=your_panel_password_here

# 3. Security & Access Control
# Temporarily shut off admin login? Set to false (default).
# When set to false, only client portal access is allowed.
# Set to true when you want to enable admin sign-in.
ADMIN_LOGIN_ENABLED=false

# Mask VPS details (protect real VPS IP and hide internal panel paths from clients)
MASK_VPS_DETAILS=true

# Optional: Public domain for client connection links (if using CDN or separate domain)
# PUBLIC_DOMAIN=your-public-cdn.com

# 4. Server Configuration
PORT=8080
METRICS_INTERVAL_MS=3000
METRICS_CACHE_TTL=3
